{
  "name": "@todayai-labs/web",
  "version": "0.0.2",
  "private": true,
  "imports": {
    "#web-extend-api": "./web-extended-prebuilt.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development pnpm run prepare && pnpm run env:prepare && pnpm run build-web-extended-prebuilt -- --mode=development && pnpm run build-host-deps && tsx scripts/dev-server.mts",
    "dev:mfe": "NODE_ENV=development pnpm run prepare && pnpm run env:prepare && pnpm run build-web-extended-prebuilt -- --mode=development && pnpm run build-host-deps && TODAY_WEB_DEV_PORT=4060 tsx scripts/dev-server.mts",
    "dev:desktop-runtime": "NODE_ENV=development pnpm run prepare && pnpm run build-host-deps && tsx scripts/dev-server.mts",
    "dev:cn": "REGION=cn pnpm run dev",
    "dev:prod": "tsx scripts/dev-production.mts oversea",
    "dev:prod:cn": "tsx scripts/dev-production.mts cn",
    "dev:remote": "cp -n .env.development.local.example .env.development.local && pnpm run dev",
    "dev:cn:remote": "cp -n .env.development.local.example .env.development.local && pnpm run dev:cn",
    "build": "NODE_ENV=production pnpm run prepare && pnpm run env:prepare:build && pnpm run build-web-extended-prebuilt -- --mode=production && pnpm run build-host-deps && next build --turbopack && pnpm run build-host-deps -- --finalize-next-build",
    "build:desktop-runtime": "NODE_ENV=production pnpm run prepare && pnpm run build-host-deps && tsgo --build --pretty --force && next build --turbopack && pnpm run build-host-deps -- --finalize-next-build",
    "build:cn": "REGION=cn pnpm run build",
    "build:local-smoke": "NODE_ENV=production pnpm run prepare && pnpm run build-web-extended-prebuilt -- --mode=production && pnpm run build-host-deps && next build --turbopack && pnpm run build-host-deps -- --finalize-next-build",
    "build:webpack": "NODE_ENV=production pnpm run prepare && pnpm run env:prepare:build && pnpm run build-web-extended-prebuilt -- --mode=production && pnpm run build-host-deps && next build --webpack && pnpm run build-host-deps -- --finalize-next-build",
    "build:cn:webpack": "REGION=cn pnpm run build:webpack",
    "build-web-extended-prebuilt": "tsx scripts/build-web-extended-prebuilt.mts",
    "build-host-deps": "tsx scripts/build-host-deps.mts",
    "start": "next start",
    "typecheck": "tsgo --build --pretty",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:runtime-traffic-lane-fetch": "node scripts/test-runtime-traffic-lane-fetch.mjs",
    "test:watch": "vitest",
    "i18n:verify": "node ../../scripts/verify-i18n.mjs",
    "test:ui": "vitest --ui",
    "test:update": "vitest run --update",
    "test:visual": "playwright test",
    "test:visual:ui": "playwright test --ui",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:linux": "tsx scripts/playwright-linux.mts test",
    "test:visual:update:linux": "tsx scripts/playwright-linux.mts test --update-snapshots",
    "test:visual:preview": "playwright test -c playwright.preview.config.ts",
    "test:visual:preview:update": "playwright test -c playwright.preview.config.ts --update-snapshots",
    "test:e2e:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:e2e:smoke:ui": "playwright test -c playwright.smoke.config.ts --ui",
    "test:e2e:full": "playwright test -c playwright.full.config.ts",
    "test:e2e:full:ui": "playwright test -c playwright.full.config.ts --ui",
    "test:e2e:canonical": "playwright test -c playwright.canonical.config.ts",
    "test:e2e:canonical:ui": "playwright test -c playwright.canonical.config.ts --ui",
    "test:e2e:today-snapshots": "playwright test -c playwright.today-snapshots.config.ts",
    "test:e2e:today-snapshots:update": "playwright test -c playwright.today-snapshots.config.ts --update-snapshots",
    "test:e2e:today-snapshots:linux": "tsx scripts/playwright-linux.mts test -c playwright.today-snapshots.config.ts",
    "test:e2e:today-snapshots:update:linux": "tsx scripts/playwright-linux.mts test -c playwright.today-snapshots.config.ts --update-snapshots",
    "test:visual:local": "playwright test -c playwright.local.config.ts",
    "test:visual:local:ui": "playwright test -c playwright.local.config.ts --ui",
    "env:dev": "echo 'Copy .env.profile.dev.example to .env.development.local and fill in client_id' && cp -n .env.profile.dev.example .env.development.local || echo '.env.development.local already exists'",
    "env:prepare": "node ../../scripts/cloud/web-local-environment.mjs --prepare",
    "env:prepare:build": "node ../../scripts/cloud/web-local-environment.mjs --prepare-build",
    "api:generate": "pnpm --filter @todayai-labs/api-client generate",
    "prepare": "tsx scripts/prepare-vars.mts && tsx scripts/prepare-file-preview-assets.mts"
  },
